#!/usr/bin/env bash
# Pre-push: enforcement gate (no CI in this repo by design).
#   1. version-gate against origin/main -- catches cumulative branch drift
#      before push (uses origin/main...HEAD; per-commit pre-commit can't see that).
#   2. hook contract tests -- the Stop/PreToolUse hooks gate every turn, so a
#      regression must not reach main.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

SCRIPT="$REPO_ROOT/scripts/check-plugin-version.sh"
[ -x "$SCRIPT" ] && BASE_REF="origin/main" bash "$SCRIPT"

if [ -d "$REPO_ROOT/tests" ]; then
  python3 -m unittest discover -s "$REPO_ROOT/tests" >/dev/null
  echo "hook tests pass"
fi
