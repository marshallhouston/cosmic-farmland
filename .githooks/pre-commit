#!/usr/bin/env bash
# Auto-bump a plugin's patch version when its source changes and the
# manifest wasn't bumped manually. Mutates the staged commit in place.
#
# Why: Claude Code plugin caches key off plugins/<name>/plugin.json version.
# Edits that don't bump version ship into the cache as the same artifact,
# so consumers keep running the old code. Auto-bump removes the friction
# of remembering to bump for solo-flow patches. For minor/major bumps,
# bump manually before committing and this hook will leave it alone.
set -euo pipefail

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$CHANGED" ] && exit 0

TOUCHED_PLUGINS=$(printf '%s\n' "$CHANGED" \
  | awk -F/ '/^plugins\// && NF >= 2 {print $1"/"$2}' \
  | sort -u)
[ -z "$TOUCHED_PLUGINS" ] && exit 0

while IFS= read -r plugin_dir; do
  manifest="$plugin_dir/plugin.json"
  [ -f "$manifest" ] || continue

  # Did anything OTHER than plugin.json change in this plugin?
  non_manifest=$(printf '%s\n' "$CHANGED" \
    | grep "^$plugin_dir/" \
    | grep -v "^$manifest$" || true)
  [ -z "$non_manifest" ] && continue

  # Is plugin.json itself staged with a version diff? Then trust the human bump.
  if printf '%s\n' "$CHANGED" | grep -qx "$manifest"; then
    if git diff --cached -- "$manifest" | grep -qE '^\+\s*"version"'; then
      continue
    fi
  fi

  current=$(jq -r .version "$manifest")
  major=$(echo "$current" | cut -d. -f1)
  minor=$(echo "$current" | cut -d. -f2)
  patch=$(echo "$current" | cut -d. -f3)
  next="${major}.${minor}.$((patch + 1))"
  jq --arg v "$next" '.version = $v' "$manifest" > "${manifest}.tmp"
  mv "${manifest}.tmp" "$manifest"
  git add "$manifest"
  echo "[pre-commit] auto-bumped $plugin_dir: $current -> $next" >&2
done <<< "$TOUCHED_PLUGINS"

exit 0
