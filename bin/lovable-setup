#!/usr/bin/env bash
set -euo pipefail

# lovable-setup: Take a freshly-exported Lovable app and make it "mine" —
# de-brand it, scaffold tests, collapse the scaffold history, freshen deps,
# and (optionally) stand it up on Railway + GitHub.
#
# Usage: lovable-setup [project-dir]
#   project-dir: path to the Lovable project (default: current directory)
#
# Design notes:
#   - Generic across the two Lovable shapes:
#       * plain vite-react   — root index.html + gptengineer.js + lovable-tagger
#       * TanStack Start var. — @lovable.dev/vite-tanstack-config, head in __root.tsx
#   - Detects deploy shape: a Dockerfile means Railway builds the image (no SPA
#     start script); otherwise it's a static SPA (add `bunx serve <out>`).
#   - Idempotent: safe to re-run; every step no-ops if already done.
#   - Destructive history rewrite (squash) is guarded + confirmed.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info()  { echo -e "${BLUE}▸${NC} $1"; }
ok()    { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }
fail()  { echo -e "${RED}✗${NC} $1"; exit 1; }
ask()   { local r; read -p "$(echo -e "${BLUE}▸${NC}") $1 [y/N] " -n 1 -r; echo ""; [[ $r =~ ^[Yy]$ ]]; }

# Resolve this script's dir (follow symlinks) to find the shared CLAUDE.md tail.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
TAIL="$SCRIPT_DIR/../templates/claude-md-tail.md"

PROJECT_DIR="${1:-.}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
cd "$PROJECT_DIR"

echo ""
echo -e "${BLUE}━━━ lovable-setup: $PROJECT_NAME ━━━${NC}"
echo ""

# ── Preflight ─────────────────────────────────────────────────────────
command -v bun >/dev/null 2>&1 || fail "bun not found. Install: brew install oven-sh/bun/bun"
command -v git >/dev/null 2>&1 || fail "git not found"
[ -f package.json ] || fail "No package.json in $PROJECT_DIR"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Not a git repository"

# ── Detect project shape ──────────────────────────────────────────────
DEPLOY_MODE="static"
[ -f Dockerfile ] && DEPLOY_MODE="docker"
HAS_PY="no"; { [ -f server/requirements.txt ] || [ -f requirements.txt ]; } && HAS_PY="yes"
info "Deploy shape: ${DEPLOY_MODE}$([ "$HAS_PY" = yes ] && echo " + python backend")"

# ── 1. Lockfiles — keep the Bun text lockfile, drop the rest ──────────
info "Cleaning lockfiles..."
# bun.lock = modern text lockfile (KEEP, tracked — Docker COPYs it).
# bun.lockb = legacy binary lockfile (drop). npm/yarn/pnpm locks (drop).
rm -f package-lock.json yarn.lock pnpm-lock.yaml bun.lockb
ok "Kept bun.lock; removed legacy/foreign lockfiles"

# ── 2. .gitignore ─────────────────────────────────────────────────────
info "Updating .gitignore..."
GI=(".claude" "node_modules" "dist" "bun.lockb" "package-lock.json" "yarn.lock" "pnpm-lock.yaml" "*.local" ".env" ".DS_Store" "coverage")
[ "$HAS_PY" = yes ] && GI+=(".venv" "__pycache__" "*.pyc")
for e in "${GI[@]}"; do grep -qxF "$e" .gitignore 2>/dev/null || echo "$e" >> .gitignore; done
ok ".gitignore updated"

# ── 3. .railwayignore — trims the `railway up` upload / Docker context ─
info "Writing .railwayignore..."
{
  echo ".git"; echo ".claude"; echo "node_modules"; echo "dist"; echo "coverage"
  echo "*.local"; echo ".DS_Store"
  if [ "$HAS_PY" = yes ]; then echo ".venv"; echo "server/.venv"; echo "__pycache__"; echo "server/__pycache__"; echo "*.pyc"; fi
} > .railwayignore
ok ".railwayignore written"

# ── 4. De-brand: strip Lovable editor hooks + branding ────────────────
info "Stripping Lovable branding..."
STRIPPED=0
# 4a. gptengineer.js editor injector — any HTML file.
while IFS= read -r f; do
  if grep -q "gpteng" "$f" 2>/dev/null; then
    sed -i '' '/cdn\.gpteng\.co/d' "$f"; STRIPPED=1
  fi
done < <(find . -name '*.html' -not -path './node_modules/*' 2>/dev/null)
# 4b. lovable-tagger dev plugin — vite config + package.json.
for vc in vite.config.ts vite.config.js vite.config.mjs; do
  [ -f "$vc" ] || continue
  if grep -q "lovable-tagger" "$vc"; then
    sed -i '' '/lovable-tagger/d; /componentTagger/d' "$vc"; STRIPPED=1
  fi
done
if grep -q '"lovable-tagger"' package.json 2>/dev/null; then
  bun remove lovable-tagger >/dev/null 2>&1 || true; STRIPPED=1
fi
if grep -q '@lovable.dev/vite-tanstack-config' package.json 2>/dev/null; then
  warn "Uses @lovable.dev/vite-tanstack-config — head/meta live in src/routes/__root.tsx."
  warn "  Replace the lovable config wrapper with plain TanStack Start + Vite by hand (plain TanStack Start + Vite plugins, no lovable wrapper)."
fi
# 4c. Lovable title / og:image meta — best-effort, in HTML.
while IFS= read -r f; do
  if grep -qi 'lovable' "$f" 2>/dev/null; then
    sed -i '' 's#https://lovable\.dev[^"'"'"']*##g; s#Lovable Generated Project#'"$PROJECT_NAME"'#g' "$f" 2>/dev/null || true
    STRIPPED=1
  fi
done < <(find . -name '*.html' -not -path './node_modules/*' 2>/dev/null)
[ "$STRIPPED" = 1 ] && ok "Lovable editor hooks / branding removed" || ok "No Lovable hooks found (already clean)"

# ── 5. Favicon — strip Lovable default, leave a placeholder + TODO ────
info "Resetting favicon..."
FAV=""
for cand in public/favicon.ico public/favicon.svg favicon.ico favicon.svg; do [ -f "$cand" ] && FAV="$cand" && break; done
if [ -n "$FAV" ] && grep -qil 'lovable' "$FAV" 2>/dev/null; then
  warn "Lovable favicon detected at $FAV — replacing with blank placeholder."
  FAV=""  # force placeholder write below
fi
if [ ! -f public/favicon.svg ] && [ ! -f favicon.svg ]; then
  mkdir -p public 2>/dev/null || true
  cat > public/favicon.svg << 'SVG'
<!-- TODO(lovable-setup): replace this placeholder with a real favicon. -->
<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
  <rect width="32" height="32" rx="6" fill="#e5e7eb"/>
</svg>
SVG
  ok "Placeholder public/favicon.svg written (TODO: add real icon)"
else
  ok "Favicon present ($([ -n "$FAV" ] && echo "$FAV" || echo favicon.svg)) — left in place"
fi

# ── 6. Start script — static SPA only (Docker builds itself) ──────────
if [ "$DEPLOY_MODE" = static ]; then
  info "Checking start script..."
  if ! grep -q '"start"' package.json; then
    # Output dir resolved after build (step 11); default to dist, fixed up later.
    if grep -q '"preview"' package.json; then
      sed -i '' '/"preview"/a\
    "start": "bunx serve dist -s -l ${PORT:-3000}",
' package.json
    else
      sed -i '' '/"build"/a\
    "start": "bunx serve dist -s -l ${PORT:-3000}",
' package.json
    fi
    ok "Added static start script (output dir verified after build)"
  else
    ok "Start script already present"
  fi
else
  ok "Docker deploy — Railway builds the Dockerfile, no start script needed"
fi

# ── 7. Install ────────────────────────────────────────────────────────
info "Installing dependencies (bun)..."
rm -rf node_modules
bun install 2>&1 | tail -3
ok "Dependencies installed"

# ── 8. Tests — Vitest + Testing Library (Lovable ships none) ──────────
info "Setting up tests (Vitest)..."
if grep -q '"vitest"' package.json 2>/dev/null; then
  ok "Vitest already configured"
else
  bun add -d vitest @testing-library/react @testing-library/jest-dom @testing-library/user-event jsdom @vitejs/plugin-react >/dev/null 2>&1 || warn "bun add for test deps hit a snag — check manually"
  grep -q '"test"' package.json || sed -i '' '/"build"/a\
    "test": "vitest run",\
    "test:watch": "vitest",
' package.json
  if [ ! -f vitest.config.ts ] && [ ! -f vitest.config.js ]; then
    cat > vitest.config.ts << 'VITEST'
import { defineConfig } from "vitest/config";
import react from "@vitejs/plugin-react";

// Standalone Vitest config (jsdom). If a test imports modules via the "@/"
// alias or relies on other vite.config plugins, mirror those here.
export default defineConfig({
  plugins: [react()],
  test: { environment: "jsdom", globals: true, setupFiles: "./src/test/setup.ts" },
});
VITEST
  fi
  mkdir -p src/test
  [ -f src/test/setup.ts ] || echo 'import "@testing-library/jest-dom";' > src/test/setup.ts
  if [ ! -f src/test/smoke.test.ts ]; then
    cat > src/test/smoke.test.ts << 'SMOKE'
import { describe, it, expect } from "vitest";

// Smoke test — proves the Vitest wiring works. Replace/expand with real tests.
describe("smoke", () => {
  it("runs", () => {
    expect(1 + 1).toBe(2);
  });
});
SMOKE
  fi
  ok "Vitest scaffolded (test + test:watch scripts, smoke test)"
fi

# ── 9. Outdated report + optional in-range update ─────────────────────
info "Checking for outdated dependencies..."
bun outdated 2>&1 || true
if ask "Update dependencies within semver ranges (bun update)?"; then
  bun update 2>&1 | tail -5
  ok "Dependencies updated (in-range)."
  warn "Major bumps NOT applied. For those: bun update --latest (review breaking changes first)."
else
  ok "Skipped update — report only"
fi

# ── 10. CLAUDE.md scaffold + shared conventions tail ──────────────────
if [ ! -f CLAUDE.md ]; then
  info "Creating CLAUDE.md..."
  cat > CLAUDE.md << CLAUDEMD
# $PROJECT_NAME

## Stack

- React + TypeScript, Vite, Tailwind CSS + shadcn/ui
- Bun for package management
- Origin: Lovable scaffold (de-branded via lovable-setup)
- Deploy: $([ "$DEPLOY_MODE" = docker ] && echo "Docker image on Railway" || echo "static SPA on Railway")

## Conventions

- \`@/\` path alias maps to \`src/\`
- \`src/components/ui/\` — shadcn/ui primitives, don't edit directly
CLAUDEMD
  ok "CLAUDE.md created"
else
  ok "CLAUDE.md already exists"
fi
# Append the shared working-conventions + testing tail (idempotent via marker).
if [ -f "$TAIL" ]; then
  if grep -q 'lovable-setup:conventions' CLAUDE.md 2>/dev/null; then
    ok "Conventions section already present"
  else
    printf '\n' >> CLAUDE.md; cat "$TAIL" >> CLAUDE.md
    ok "Appended working-conventions + testing section to CLAUDE.md"
  fi
else
  warn "Conventions snippet not found ($TAIL) — skipped CLAUDE.md tail"
fi

# ── 11. Build + test verification (+ fix static start dir) ────────────
info "Verifying build..."
bun run build 2>&1 | tail -5 || fail "Build failed — fix errors before deploying"
OUT="dist"; [ -d dist/client ] && OUT="dist/client"
if [ "$DEPLOY_MODE" = static ] && [ "$OUT" != dist ]; then
  sed -i '' "s#bunx serve dist #bunx serve $OUT #" package.json 2>/dev/null || true
  ok "Build OK — start script points at $OUT"
else
  ok "Build OK (output: $OUT)"
fi
info "Running tests..."
bun run test 2>&1 | tail -8 || fail "Tests failed — fix before continuing"
ok "Tests pass"

# ── 12. Collapse scaffold history into one initial commit (guarded) ───
info "Reviewing commit history..."
git add -A
COMMITS=$(git rev-list --count HEAD)
PUSHED="no"
if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  [ -n "$(git log @{u}..HEAD --oneline 2>/dev/null)" ] || PUSHED="yes"
  [ -z "$(git log HEAD..@{u} --oneline 2>/dev/null)" ] && [ "$(git rev-list --count @{u})" -gt 0 ] && PUSHED="yes"
fi
if [ "$COMMITS" -le 1 ]; then
  ok "Single commit already — nothing to collapse"
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
elif [ "$PUSHED" = yes ]; then
  warn "History ($COMMITS commits) already pushed to a remote — squashing would require a force-push."
  warn "  Skipping collapse. Squash manually only if you're sure no one else has the branch."
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
elif ask "Collapse all $COMMITS commits into one 'Initial scaffold (Lovable)'?"; then
  ROOT=$(git rev-list --max-parents=0 HEAD | tail -1)
  git reset --soft "$ROOT"
  git commit --amend -m "Initial scaffold (Lovable), de-branded + configured

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>" >/dev/null
  ok "History collapsed to one commit"
else
  ok "Kept history; committing setup changes"
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
fi

# ── 13. GitHub repo ───────────────────────────────────────────────────
echo ""
if git remote get-url origin >/dev/null 2>&1; then
  info "Pushing to existing origin..."
  git push --force-with-lease 2>/dev/null || git push
  ok "Pushed"
elif command -v gh >/dev/null 2>&1; then
  if ask "Create a PRIVATE GitHub repo and push?"; then
    gh repo create "$PROJECT_NAME" --private --source=. --push
    ok "GitHub repo created + pushed"
  fi
else
  warn "No origin + gh not installed — skipping GitHub. Install: brew install gh"
fi

# ── 14. Railway ───────────────────────────────────────────────────────
echo ""
if command -v railway >/dev/null 2>&1; then
  if railway status >/dev/null 2>&1; then
    ok "Railway project already linked — skipping create"
  elif ask "Set up a Railway project?"; then
    railway init --name "$PROJECT_NAME"
    info "Deploying..."
    railway up 2>&1 || true
    info "Generating domain..."
    railway domain 2>&1 || true
    ok "Deployed"
    if [ "$DEPLOY_MODE" = static ]; then
      warn "Set Start Command in Railway: Service → Settings → Deploy → 'bun run start'"
    else
      ok "Docker deploy — Railway auto-builds the Dockerfile, no start command needed"
    fi
  fi
else
  warn "Railway CLI not installed — skipping. Install: brew install railway"
fi

# ── 15. The one manual step: GitHub → Railway auto-deploy ─────────────
echo ""
warn "GitHub→Railway auto-deploy is OAuth dashboard-only (CLI can't wire it):"
echo  "    Railway dashboard → service → Settings → Source → Connect repo + branch main"
[ "$DEPLOY_MODE" = docker ] && echo "    Keep Root Directory unset so the root Dockerfile builds."

echo ""
echo -e "${GREEN}━━━ Setup complete — $PROJECT_NAME ($DEPLOY_MODE) ━━━${NC}"
echo ""
