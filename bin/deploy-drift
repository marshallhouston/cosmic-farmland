#!/usr/bin/env bash
# Flag repos whose Railway production deploy is behind main.
# Railway's GitHub app records each deploy as a GitHub deployment, so this only needs `gh`.
#
#   bin/deploy-drift                       # every repo you own that Railway deploys
#   bin/deploy-drift preach-hub rodeo-dunes
#
# Exits 1 if any repo is drifted. (why: 2026-10-22 every merge across 8 repos
# silently skipped deploy; 4 prod apps kept known RCE/XSS code for 3 days.)
set -euo pipefail

OWNER="${DEPLOY_DRIFT_OWNER:-$(gh api user -q .login)}"
GRACE_MIN="${DEPLOY_DRIFT_GRACE_MIN:-15}" # a just-merged commit is still building, not drifted
repos=("$@")
if [ $# -eq 0 ]; then
  while read -r n; do repos+=("$n"); done < <(gh repo list "$OWNER" --no-archived --limit 200 --json name -q '.[].name')
fi

now=$(date -u +%s)
drift=0
for r in "${repos[@]}"; do
  read -r dep dep_id < <(gh api "repos/$OWNER/$r/deployments?per_page=10" \
    -q '[.[]|select(.creator.login=="railway-app[bot]" and (.environment|test("production")))][0]|"\(.sha) \(.id)" // empty' 2>/dev/null || true)
  [ -n "${dep:-}" ] && [ "$dep" != null ] || continue # not deployed by Railway
  # newest deploy "inactive" = service torn down (e.g. project deleted), nothing live to drift
  [ "$(gh api "repos/$OWNER/$r/deployments/$dep_id/statuses?per_page=1" -q '.[0].state' 2>/dev/null)" != inactive ] || continue
  read -r head when < <(gh api "repos/$OWNER/$r/commits/main" -q '.sha+" "+.commit.committer.date')
  if [ "$dep" = "$head" ]; then
    echo "ok     $r ${head:0:7}"
    continue
  fi
  age_min=$(( (now - $(date -u -j -f %Y-%m-%dT%H:%M:%SZ "$when" +%s 2>/dev/null || date -u -d "$when" +%s)) / 60 ))
  if [ "$age_min" -lt "$GRACE_MIN" ]; then
    echo "wait   $r main ${head:0:7} merged ${age_min}m ago"
  else
    echo "DRIFT  $r prod ${dep:0:7} != main ${head:0:7} (main ${age_min}m old) -> railway redeploy --from-source"
    drift=1
  fi
done
exit $drift
