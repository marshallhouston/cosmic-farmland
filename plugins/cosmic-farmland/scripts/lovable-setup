#!/usr/bin/env bash
set -euo pipefail

# lovable-setup: Take a freshly-exported Lovable app and make it "mine" —
# de-brand it, scaffold tests, collapse the scaffold history, freshen deps,
# and (optionally) stand it up on Railway + GitHub.
#
# Usage: lovable-setup [project-dir]
#   project-dir: path to the Lovable project (default: current directory)
#
# Design notes:
#   - Generic across the two Lovable shapes:
#       * plain vite-react   — root index.html + gptengineer.js + lovable-tagger
#       * TanStack Start var. — @lovable.dev/vite-tanstack-config, head in __root.tsx
#   - Detects deploy shape: a Dockerfile means Railway builds the image (no SPA
#     start script); otherwise it's a static SPA (add `bunx serve <out>`).
#   - Idempotent: safe to re-run; every step no-ops if already done.
#   - Destructive history rewrite (squash) is guarded + confirmed.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info()  { echo -e "${BLUE}▸${NC} $1"; }
ok()    { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }
fail()  { echo -e "${RED}✗${NC} $1"; exit 1; }
ask()   { local r; read -p "$(echo -e "${BLUE}▸${NC}") $1 [y/N] " -n 1 -r; echo ""; [[ $r =~ ^[Yy]$ ]]; }

# brew_offer <cmd> <formula> <purpose>: if <cmd> is missing, offer to brew-install
# it. Returns 0 if the command is available afterward, 1 if still missing.
brew_offer() {
  command -v "$1" >/dev/null 2>&1 && return 0
  if command -v brew >/dev/null 2>&1; then
    ask "$1 not found ($3). Install via 'brew install $2'?" && brew install "$2" && return 0
  else
    warn "$1 missing ($3) and Homebrew absent -- install $1 manually."
  fi
  return 1
}

# Resolve this script's dir (follow symlinks) to find the shared CLAUDE.md tail.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
TAIL="$SCRIPT_DIR/../templates/claude-md-tail.md"

PROJECT_DIR="${1:-.}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
cd "$PROJECT_DIR"

echo ""
echo -e "${BLUE}━━━ lovable-setup: $PROJECT_NAME ━━━${NC}"
echo ""

# ── Preflight ─────────────────────────────────────────────────────────
brew_offer git git "version control" || fail "git is required -- install it and re-run"
brew_offer bun oven-sh/bun/bun "package manager + builds" || fail "bun is required -- install it and re-run"
[ -f package.json ] || fail "No package.json in $PROJECT_DIR"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Not a git repository"

# ── Detect project shape ──────────────────────────────────────────────
# Precedence: docker (Dockerfile) > tanstack-ssr (@tanstack/react-start) > static SPA.
SHAPE="static"
[ -f Dockerfile ] && SHAPE="docker"
if [ "$SHAPE" = static ] && grep -q '"@tanstack/react-start"' package.json 2>/dev/null; then
  SHAPE="tanstack-ssr"
fi
HAS_PY="no"; { [ -f server/requirements.txt ] || [ -f requirements.txt ]; } && HAS_PY="yes"
info "Project shape: ${SHAPE}$([ "$HAS_PY" = yes ] && echo " + python backend")"

# ── 1. Lockfiles — keep the Bun text lockfile, drop the rest ──────────
info "Cleaning lockfiles..."
# bun.lock = modern text lockfile (KEEP, tracked — Docker COPYs it).
# bun.lockb = legacy binary lockfile (drop). npm/yarn/pnpm locks (drop).
rm -f package-lock.json yarn.lock pnpm-lock.yaml bun.lockb
ok "Kept bun.lock; removed legacy/foreign lockfiles"

# ── 2. .gitignore ─────────────────────────────────────────────────────
info "Updating .gitignore..."
GI=(".claude" "node_modules" "dist" "bun.lockb" "package-lock.json" "yarn.lock" "pnpm-lock.yaml" "*.local" ".env" ".DS_Store" "coverage" ".tokensave")
[ "$HAS_PY" = yes ] && GI+=(".venv" "__pycache__" "*.pyc")
for e in "${GI[@]}"; do grep -qxF "$e" .gitignore 2>/dev/null || echo "$e" >> .gitignore; done
ok ".gitignore updated"

# ── 3. .railwayignore — trims the `railway up` upload / Docker context ─
info "Writing .railwayignore..."
{
  echo ".git"; echo ".claude"; echo "node_modules"; echo "dist"; echo "coverage"
  echo "*.local"; echo ".DS_Store"
  if [ "$HAS_PY" = yes ]; then echo ".venv"; echo "server/.venv"; echo "__pycache__"; echo "server/__pycache__"; echo "*.pyc"; fi
} > .railwayignore
ok ".railwayignore written"

# ── 4. De-brand: strip Lovable editor hooks + branding ────────────────
info "Stripping Lovable branding..."
STRIPPED=0
# 4a. gptengineer.js editor injector — any HTML file.
while IFS= read -r f; do
  if grep -q "gpteng" "$f" 2>/dev/null; then
    sed -i '' '/cdn\.gpteng\.co/d' "$f"; STRIPPED=1
  fi
done < <(find . -name '*.html' -not -path './node_modules/*' 2>/dev/null)
# 4b. lovable-tagger dev plugin — vite config + package.json.
for vc in vite.config.ts vite.config.js vite.config.mjs; do
  [ -f "$vc" ] || continue
  if grep -q "lovable-tagger" "$vc"; then
    sed -i '' '/lovable-tagger/d; /componentTagger/d' "$vc"; STRIPPED=1
  fi
done
if grep -q '"lovable-tagger"' package.json 2>/dev/null; then
  bun remove lovable-tagger >/dev/null 2>&1 || true; STRIPPED=1
fi
if grep -q '@lovable.dev/vite-tanstack-config' package.json 2>/dev/null; then
  info "Detected @lovable.dev wrapper — will attempt a build-gated plain-config swap after install."
fi
# SSR head/title/og live in src/routes/__root.tsx, not an HTML file. De-brand the
# DISPLAY strings only; leave functional code (e.g. lovable-error-reporting imports) intact.
if [ -f src/routes/__root.tsx ]; then
  sed -i '' 's#https://lovable\.dev[^"'"'"']*##g; s#Lovable Generated Project#'"$PROJECT_NAME"'#g; s#Lovable App#'"$PROJECT_NAME"'#g; s#{ name: "author", content: "Lovable" }#{ name: "author", content: "'"$PROJECT_NAME"'" }#g; s#"@Lovable"#"@'"$PROJECT_NAME"'"#g' src/routes/__root.tsx 2>/dev/null || true
  ok "De-branded src/routes/__root.tsx head/meta (functional code left intact)"
fi
# 4c. Lovable title / og:image meta — best-effort, in HTML.
while IFS= read -r f; do
  if grep -qi 'lovable' "$f" 2>/dev/null; then
    sed -i '' 's#https://lovable\.dev[^"'"'"']*##g; s#Lovable Generated Project#'"$PROJECT_NAME"'#g' "$f" 2>/dev/null || true
    STRIPPED=1
  fi
done < <(find . -name '*.html' -not -path './node_modules/*' 2>/dev/null)
[ "$STRIPPED" = 1 ] && ok "Lovable editor hooks / branding removed" || ok "No Lovable hooks found (already clean)"

# ── 5. Favicon — strip Lovable default, leave a placeholder + TODO ────
info "Resetting favicon..."
FAV=""
for cand in public/favicon.ico public/favicon.svg favicon.ico favicon.svg; do [ -f "$cand" ] && FAV="$cand" && break; done
if [ -n "$FAV" ] && grep -qil 'lovable' "$FAV" 2>/dev/null; then
  warn "Lovable favicon detected at $FAV — replacing with blank placeholder."
  FAV=""  # force placeholder write below
fi
if [ ! -f public/favicon.svg ] && [ ! -f favicon.svg ]; then
  mkdir -p public 2>/dev/null || true
  cat > public/favicon.svg << 'SVG'
<!-- TODO(lovable-setup): replace this placeholder with a real favicon. -->
<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
  <rect width="32" height="32" rx="6" fill="#e5e7eb"/>
</svg>
SVG
  ok "Placeholder public/favicon.svg written (TODO: add real icon)"
else
  ok "Favicon present ($([ -n "$FAV" ] && echo "$FAV" || echo favicon.svg)) — left in place"
fi

# ── 6. Start script + SSR runtime shim ────────────────────────────────
if [ "$SHAPE" = tanstack-ssr ]; then
  info "Writing bun-serve SSR shim (server-entry.ts)..."
  if [ -f server-entry.ts ]; then
    ok "server-entry.ts already present — left in place"
  else
    cat > server-entry.ts << 'SHIM'
// server-entry.ts — bun-native prod runtime for TanStack Start SSR (lovable-setup).
// The build emits dist/server/server.js, a Web-standard { fetch(req, env, ctx) }
// handler that does NOT listen on a port. This shim wraps it with Bun.serve,
// serves hashed client assets from dist/client, and listens on $PORT.
// Start: bun server-entry.ts   (Railway start command: bun run start)
const ENTRY = (await Bun.file("./dist/server/server.js").exists())
  ? "./dist/server/server.js"
  : "./.output/server/index.mjs"; // fallback if a future build emits a nitro layout
const mod = await import(ENTRY);
const app = (mod.default ?? mod) as {
  fetch: (req: Request, env: unknown, ctx: unknown) => Response | Promise<Response>;
};
const port = Number(process.env.PORT ?? 3000);
Bun.serve({
  port,
  idleTimeout: 60,
  async fetch(req) {
    const url = new URL(req.url);
    if (url.pathname !== "/") {
      const file = Bun.file(`./dist/client${url.pathname}`);
      if (await file.exists()) return new Response(file);
    }
    return app.fetch(req, process.env, {});
  },
});
console.log(`SSR listening on :${port}`);
SHIM
    ok "server-entry.ts written (bun-serve SSR runtime)"
  fi
  if grep -q '"start"' package.json; then
    ok "Start script already present"
  else
    sed -i '' '/"build"/a\
    "start": "bun server-entry.ts",
' package.json
    ok "Added SSR start script (bun server-entry.ts)"
  fi
elif [ "$SHAPE" = static ]; then
  info "Checking start script..."
  if ! grep -q '"start"' package.json; then
    if grep -q '"preview"' package.json; then
      sed -i '' '/"preview"/a\
    "start": "bunx serve dist -s -l ${PORT:-3000}",
' package.json
    else
      sed -i '' '/"build"/a\
    "start": "bunx serve dist -s -l ${PORT:-3000}",
' package.json
    fi
    ok "Added static start script (output dir verified after build)"
  else
    ok "Start script already present"
  fi
else
  ok "Docker deploy — Railway builds the Dockerfile, no start script needed"
fi

# ── 7. Install ────────────────────────────────────────────────────────
info "Installing dependencies (bun)..."
rm -rf node_modules
bun install 2>&1 | tail -3
ok "Dependencies installed"

# ── 8. Tests — Vitest + Testing Library (Lovable ships none) ──────────
info "Setting up tests (Vitest)..."
if grep -q '"vitest"' package.json 2>/dev/null; then
  ok "Vitest already configured"
else
  bun add -d vitest @testing-library/react @testing-library/jest-dom @testing-library/user-event jsdom @vitejs/plugin-react >/dev/null 2>&1 || warn "bun add for test deps hit a snag — check manually"
  grep -q '"test"' package.json || sed -i '' '/"build"/a\
    "test": "vitest run",\
    "test:watch": "vitest",
' package.json
  if [ ! -f vitest.config.ts ] && [ ! -f vitest.config.js ]; then
    cat > vitest.config.ts << 'VITEST'
import { defineConfig } from "vitest/config";
import react from "@vitejs/plugin-react";

// Standalone Vitest config (jsdom). If a test imports modules via the "@/"
// alias or relies on other vite.config plugins, mirror those here.
export default defineConfig({
  plugins: [react()],
  test: { environment: "jsdom", globals: true, setupFiles: "./src/test/setup.ts" },
});
VITEST
  fi
  mkdir -p src/test
  [ -f src/test/setup.ts ] || echo 'import "@testing-library/jest-dom";' > src/test/setup.ts
  if [ ! -f src/test/smoke.test.ts ]; then
    cat > src/test/smoke.test.ts << 'SMOKE'
import { describe, it, expect } from "vitest";

// Smoke test — proves the Vitest wiring works. Replace/expand with real tests.
describe("smoke", () => {
  it("runs", () => {
    expect(1 + 1).toBe(2);
  });
});
SMOKE
  fi
  ok "Vitest scaffolded (test + test:watch scripts, smoke test)"
fi

# ── 8b. Pre-push deploy gate — run tests before pushing main ──────────
info "Installing pre-push deploy gate..."
mkdir -p .githooks
if [ -f .githooks/pre-push ]; then
  ok "pre-push hook already present — left in place"
else
  cat > .githooks/pre-push << 'HOOK'
#!/usr/bin/env bash
# Deploy gate: pushing `main` runs the test suite first and blocks the push if
# it fails. Other branches push freely. Escape hatch: git push --no-verify.
# Versioned hook — activate with: git config core.hooksPath .githooks
set -euo pipefail
ZERO="0000000000000000000000000000000000000000"
gate=0
while read -r _localref localsha _remoteref _remotesha; do
  [ "$_remoteref" = "refs/heads/main" ] && [ "$localsha" != "$ZERO" ] && gate=1
done
[ "$gate" -eq 1 ] || exit 0
ROOT="$(git rev-parse --show-toplevel)"
echo "── pre-push: main → deploy. running tests ──"
# Prefer a project test runner (frontend+backend, worktree-safe); else just vitest.
if [ -x "$ROOT/bin/test.sh" ]; then "$ROOT/bin/test.sh"; else (cd "$ROOT" && bun run test); fi
HOOK
  chmod +x .githooks/pre-push
  ok "Wrote .githooks/pre-push (runs tests on push to main)"
fi
# Activate (local git config, not a tracked file; idempotent). Worktrees inherit it.
if [ "$(git config core.hooksPath || true)" != ".githooks" ]; then
  git config core.hooksPath .githooks
  ok "Activated core.hooksPath=.githooks"
else
  ok "core.hooksPath already .githooks"
fi

# ── 9. Outdated report + optional in-range update ─────────────────────
info "Checking for outdated dependencies..."
bun outdated 2>&1 || true
if ask "Update dependencies within semver ranges (bun update)?"; then
  bun update 2>&1 | tail -5
  ok "Dependencies updated (in-range)."
  warn "Major bumps NOT applied. For those: bun update --latest (review breaking changes first)."
else
  ok "Skipped update — report only"
fi

# ── 10. CLAUDE.md scaffold + shared conventions tail ──────────────────
if [ ! -f CLAUDE.md ]; then
  info "Creating CLAUDE.md..."
  cat > CLAUDE.md << CLAUDEMD
# $PROJECT_NAME

## Stack

- React + TypeScript, Vite, Tailwind CSS + shadcn/ui
- Bun for package management
- Origin: Lovable scaffold (de-branded via lovable-setup)
- Deploy: $([ "$SHAPE" = docker ] && echo "Docker image on Railway" || echo "static SPA on Railway")

## Conventions

- \`@/\` path alias maps to \`src/\`
- \`src/components/ui/\` — shadcn/ui primitives, don't edit directly
CLAUDEMD
  ok "CLAUDE.md created"
else
  ok "CLAUDE.md already exists"
fi
# Append the shared working-conventions + testing tail (idempotent via marker).
if [ -f "$TAIL" ]; then
  if grep -q 'lovable-setup:conventions' CLAUDE.md 2>/dev/null; then
    ok "Conventions section already present"
  else
    printf '\n' >> CLAUDE.md; cat "$TAIL" >> CLAUDE.md
    ok "Appended working-conventions + testing section to CLAUDE.md"
  fi
else
  warn "Conventions snippet not found ($TAIL) — skipped CLAUDE.md tail"
fi

# ── tokensave — index for code-graph exploration ─────────────────────
if brew_offer tokensave aovestdipaperino/tap/tokensave "code-graph exploration"; then
  if [ -d .tokensave ]; then
    info "tokensave already initialized — syncing..."
    tokensave sync >/dev/null 2>&1 || true
    ok "tokensave synced"
  else
    info "Initializing tokensave (code graph + agent integration)..."
    if tokensave init >/dev/null 2>&1 && tokensave install >/dev/null 2>&1; then
      ok "tokensave indexed + agent integration configured"
    else
      warn "tokensave init/install hit a snag — run 'tokensave init' manually"
    fi
  fi
else
  warn "Skipping tokensave code-graph index (not installed)."
fi

# ── 10b. De-brand: replace @lovable.dev wrapper with plain config (gated) ─
if [ "$SHAPE" = tanstack-ssr ] && grep -q '@lovable.dev/vite-tanstack-config' package.json 2>/dev/null && [ -f vite.config.ts ]; then
  if ask "Replace @lovable.dev/vite-tanstack-config with plain TanStack Start + Vite config? (build-gated, auto-rollback)"; then
    info "Swapping wrapper for plain config..."
    cp vite.config.ts vite.config.ts.bak
    cat > vite.config.ts << 'PLAINVITE'
// vite.config.ts — plain TanStack Start + Vite (de-branded from
// @lovable.dev/vite-tanstack-config). Dropped: componentTagger (Lovable editor hook),
// dev error-loggers, hmr-gate, dev-server-bridge, sandbox port-pinning, and the
// nitro cloudflare deploy plugin (skipped outside a Lovable sandbox anyway).
// Build emits dist/client + dist/server/server.js (a Web fetch handler) — run it
// with the bun-serve shim (server-entry.ts). VITE_* env vars are auto-exposed by Vite.
import { defineConfig } from "vite";
import { tanstackStart } from "@tanstack/react-start/plugin/vite";
import viteReact from "@vitejs/plugin-react";
import tailwindcss from "@tailwindcss/vite";
import tsConfigPaths from "vite-tsconfig-paths";

export default defineConfig({
  server: { host: "::", port: 8080 },
  resolve: {
    alias: { "@": `${process.cwd()}/src` },
    dedupe: [
      "react",
      "react-dom",
      "react/jsx-runtime",
      "react/jsx-dev-runtime",
      "@tanstack/react-query",
      "@tanstack/query-core",
    ],
  },
  plugins: [
    tailwindcss(),
    tsConfigPaths({ projects: ["./tsconfig.json"] }),
    tanstackStart({
      server: { entry: "server" },
      importProtection: {
        behavior: "error",
        client: { files: ["**/server/**"], specifiers: ["server-only"] },
      },
    }),
    viteReact(),
  ],
});
PLAINVITE
    # The plain config imports 4 wrapper peer-deps. Lovable already lists them as
    # direct deps at vite-compatible versions; pin-add only any that are MISSING (so
    # `bun remove` can't prune them). NEVER `bun add @latest` — that pulls e.g.
    # @vitejs/plugin-react@6 which needs a newer vite and breaks the build.
    for dep in @vitejs/plugin-react @tailwindcss/vite vite-tsconfig-paths @tanstack/react-start; do
      grep -q "\"$dep\"" package.json && continue
      dv=$(grep '"version"' "node_modules/$dep/package.json" 2>/dev/null | head -1 | sed 's/.*: *"//; s/".*//')
      [ -n "$dv" ] && bun add -d "$dep@$dv" >/dev/null 2>&1 || true
    done
    bun remove @lovable.dev/vite-tanstack-config >/dev/null 2>&1 || true
    if bun run build >/dev/null 2>&1 && [ -f dist/server/server.js ]; then
      rm -f vite.config.ts.bak
      ok "Wrapper replaced with plain config (build verified, emits dist/server/server.js)"
    else
      mv vite.config.ts.bak vite.config.ts
      bun add -d @lovable.dev/vite-tanstack-config >/dev/null 2>&1 || true
      bun install >/dev/null 2>&1 || true
      warn "Plain-config build failed — restored @lovable.dev wrapper. Replace by hand for a clean break."
    fi
  else
    ok "Kept @lovable.dev wrapper (shim deploys its output regardless)"
  fi
fi

# ── 11. Build + test verification (+ fix static start dir) ────────────
info "Verifying build..."
bun run build 2>&1 | tail -5 || fail "Build failed — fix errors before deploying"
if [ "$SHAPE" = tanstack-ssr ]; then
  [ -f dist/server/server.js ] || fail "SSR build did not emit dist/server/server.js — shim has nothing to wrap"
  info "Smoke-testing SSR shim..."
  PORT=8799 bun server-entry.ts >/tmp/lovable-setup-shim.log 2>&1 & SHIM_PID=$!
  sleep 2
  if curl -fsS http://localhost:8799/ >/dev/null 2>&1; then
    ok "Build OK — SSR shim boots + serves / (200)"
  else
    kill "$SHIM_PID" 2>/dev/null || true
    cat /tmp/lovable-setup-shim.log
    fail "SSR shim failed its smoke check — see log above"
  fi
  kill "$SHIM_PID" 2>/dev/null || true
elif [ "$SHAPE" = static ]; then
  OUT="dist"; [ -d dist/client ] && OUT="dist/client"
  if [ "$OUT" != dist ]; then
    sed -i '' "s#bunx serve dist #bunx serve $OUT #" package.json 2>/dev/null || true
    ok "Build OK — start script points at $OUT"
  else
    ok "Build OK (output: $OUT)"
  fi
else
  ok "Build OK (Docker — Railway builds the image)"
fi
info "Running tests..."
bun run test 2>&1 | tail -8 || fail "Tests failed — fix before continuing"
ok "Tests pass"

# ── 12. Collapse scaffold history into one initial commit (guarded) ───
info "Reviewing commit history..."
git add -A
COMMITS=$(git rev-list --count HEAD)
PUSHED="no"
if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  [ -n "$(git log @{u}..HEAD --oneline 2>/dev/null)" ] || PUSHED="yes"
  [ -z "$(git log HEAD..@{u} --oneline 2>/dev/null)" ] && [ "$(git rev-list --count @{u})" -gt 0 ] && PUSHED="yes"
fi
if [ "$COMMITS" -le 1 ]; then
  ok "Single commit already — nothing to collapse"
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
elif [ "$PUSHED" = yes ]; then
  warn "History ($COMMITS commits) already pushed to a remote — squashing would require a force-push."
  warn "  Skipping collapse. Squash manually only if you're sure no one else has the branch."
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
elif ask "Collapse all $COMMITS commits into one 'Initial scaffold (Lovable)'?"; then
  ROOT=$(git rev-list --max-parents=0 HEAD | tail -1)
  git reset --soft "$ROOT"
  git commit --amend -m "Initial scaffold (Lovable), de-branded + configured

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>" >/dev/null
  ok "History collapsed to one commit"
else
  ok "Kept history; committing setup changes"
  git diff --cached --quiet || git commit -m "Setup: de-brand + configure (lovable-setup)" >/dev/null
fi

# ── 13. GitHub repo ───────────────────────────────────────────────────
echo ""
if git remote get-url origin >/dev/null 2>&1; then
  info "Pushing to existing origin..."
  git push --force-with-lease 2>/dev/null || git push
  ok "Pushed"
elif brew_offer gh gh "create the GitHub repo"; then
  if ask "Create a PRIVATE GitHub repo and push?"; then
    gh repo create "$PROJECT_NAME" --private --source=. --push
    ok "GitHub repo created + pushed"
  fi
else
  warn "Skipping GitHub -- no gh CLI."
fi

# ── 14. Railway ───────────────────────────────────────────────────────
echo ""
if brew_offer railway railway "deploy to Railway"; then
  if railway status >/dev/null 2>&1; then
    ok "Railway project already linked — skipping create"
  elif ask "Set up a Railway project?"; then
    railway init --name "$PROJECT_NAME"
    info "Deploying..."
    railway up 2>&1 || true
    info "Generating domain..."
    railway domain 2>&1 || true
    ok "Deployed"
    if [ "$SHAPE" = static ]; then
      warn "Set Start Command in Railway: Service → Settings → Deploy → 'bun run start'"
    else
      ok "Docker deploy — Railway auto-builds the Dockerfile, no start command needed"
    fi
  fi
else
  warn "Skipping Railway -- no railway CLI."
fi

# ── 15. The one manual step: GitHub → Railway auto-deploy ─────────────
echo ""
warn "GitHub→Railway auto-deploy is OAuth dashboard-only (CLI can't wire it):"
echo  "    Railway dashboard → service → Settings → Source → Connect repo + branch main"
[ "$SHAPE" = docker ] && echo "    Keep Root Directory unset so the root Dockerfile builds."

echo ""
echo -e "${GREEN}━━━ Setup complete — $PROJECT_NAME ($SHAPE) ━━━${NC}"
echo ""
